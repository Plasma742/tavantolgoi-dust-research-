# Backend configuration. Copy to api/.env (git-ignored). Contains NO secrets by design:
# Earth Engine credentials come from `earthengine authenticate` (local) or Application
# Default Credentials / the Cloud Run service identity (production) — never from a file in git.

# Google Cloud project registered for (noncommercial) Earth Engine use. Empty => NOT_CONFIGURED.
EE_PROJECT_ID=
# persistent = credentials from `earthengine authenticate`; adc = Application Default Credentials
EE_AUTH_MODE=persistent

# Browser origins allowed to call the API directly (the Vite dev proxy does not need this).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request bounds (quota protection). Defaults shown.
MAX_ROI_AREA_KM2=10000
MAX_ROI_VERTICES=2000
# west,south,east,north — requests outside are refused
ALLOWED_BBOX=87,41,120,52.5
MAX_LAYER_DAYS=31
MAX_SERIES_MONTHS=36
EE_MAX_PARALLEL=3
LAYER_CACHE_TTL_S=3600
STATS_CACHE_TTL_S=86400

# Directory of server-registered ROI GeoJSON Features (see data/roi/README.md).
# Keep restricted geometry OUTSIDE the repository and point this at it.
ROI_DIR=data/roi
