{
  "name": "tavantolgoi-dust-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "React + TypeScript research dashboard for the Tavan Tolgoi Dust Research Platform (not publicly deployed)",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
