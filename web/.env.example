# Frontend build-time settings. These are PUBLIC (bundled into the browser) — never put secrets here.
# Leave VITE_API_BASE empty to use the dev-server proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE=
# Basemap is display context only (not analysis data). Check the provider's terms before any deployment.
VITE_BASEMAP_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_BASEMAP_ATTRIBUTION=Basemap: Esri World Imagery (© Esri and its data providers)
